<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Hunt 26 C6: the daily automatic backup job is kept over a restart (JobInfo.setPersisted needs this). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <application android:label="MyBudget" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher" android:theme="@style/AppTheme" android:allowBackup="false" android:supportsRtl="true">
        <activity android:name=".MainActivity" android:exported="true" android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation"><!-- hunt 25 C1: rotating or resizing (split screen) keeps open forms and what was typed; onConfigurationChanged draws the screen again -->
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
            <!-- App shortcuts: Add transaction, Budget, Transactions (the MainActivity.OPEN extra, as the widget). -->
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts"/>
        </activity>
        <!-- The home-screen widget. Exported only because the system's APPWIDGET_UPDATE needs it; it acts on widget broadcasts only. -->
        <receiver android:name=".BudgetWidget" android:exported="true" android:label="MyBudget">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/budget_widget"/>
        </receiver>
        <!-- Planner's "Send paid bills to MyBudget". Open to any app; nothing is saved without the user's tap. -->
        <!-- Hunt 26 C5: the shortcuts' first stop, in a task of its own (Android clears a static shortcut's task), handing over to MainActivity. -->
        <activity android:name=".ShortcutActivity" android:exported="true" android:taskAffinity="" android:excludeFromRecents="true" android:noHistory="true" android:theme="@android:style/Theme.Translucent.NoTitleBar"/>
        <activity android:name=".AddExpenseActivity" android:exported="true" android:theme="@style/AppTheme.Overlay" android:excludeFromRecents="true" android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|locale|layoutDirection"><!-- hunt 24 E9: rotating or a theme change keeps the open dialog and what was typed -->
            <intent-filter><action android:name="com.mybudget.app.action.ADD_EXPENSE"/><category android:name="android.intent.category.DEFAULT"/></intent-filter>
            <intent-filter><action android:name="com.mybudget.app.action.PAYMENT_UNDONE"/><category android:name="android.intent.category.DEFAULT"/></intent-filter>
        </activity>
        <!-- Planner's upcoming bills (see PlannerBills): a list to plan with, never money. -->
        <receiver android:name=".PlannerBills" android:exported="true">
            <intent-filter><action android:name="com.mybudget.app.action.UPCOMING_BILLS"/></intent-filter>
        </receiver>
        <!-- Automatic backup: a daily job that saves a backup file to the folder the user picked. -->
        <!-- Take a photo: the camera app writes into one cache file it's granted for that capture (see PhotoProvider). No CAMERA permission: the camera app takes the photo. -->
        <provider android:name=".PhotoProvider" android:authorities="${applicationId}.photos" android:exported="false" android:grantUriPermissions="true"/>
        <service android:name=".AutoBackup" android:permission="android.permission.BIND_JOB_SERVICE" android:exported="false"/>
    </application>
</manifest>
