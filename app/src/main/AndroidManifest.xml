<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Hunt 26 C6: the daily automatic backup job is kept over a restart (JobInfo.setPersisted needs this). Reminders: their
         alarms are set again after a restart (BootReceiver). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- Reminders, as Planner's: notifications; exact alarms, which alone let a reminder start a ringing alarm (in silent and
         vibrate mode too). From Android 13, USE_EXACT_ALARM is granted at install and can't be turned off, as for alarm and
         calendar apps; from Android 14 SCHEDULE_EXACT_ALARM is off until the user allows it, so it is kept for Android 12 and
         lower only. The ringing service plays the alarm sound in the foreground, with a wake lock and vibration. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32"/>
    <uses-permission android:name="android.permission.USE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <application android:name=".MyBudgetApp" android:label="MyBudget" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher" android:theme="@style/AppTheme" android:allowBackup="false" android:supportsRtl="true">
        <activity android:name=".MainActivity" android:exported="true" android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation"><!-- hunt 25 C1: rotating or resizing (split screen) keeps open forms and what was typed; onConfigurationChanged draws the screen again -->
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
            <!-- App shortcuts: Add transaction, Budget, Transactions (the MainActivity.OPEN extra, as the widget). -->
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts"/>
        </activity>
        <!-- The home-screen widget. Exported only because the system's APPWIDGET_UPDATE needs it; it acts on widget broadcasts only. -->
        <receiver android:name=".BudgetWidget" android:exported="true" android:label="MyBudget">
            <intent-filter><action android:name="android.appwidget.action.APPWIDGET_UPDATE"/></intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/budget_widget"/>
        </receiver>
        <!-- Planner's "Send paid bills to MyBudget". Open to any app; nothing is saved without the user's tap. -->
        <!-- Hunt 26 C5: the shortcuts' first stop, in a task of its own (Android clears a static shortcut's task), handing over to MainActivity. -->
        <activity android:name=".ShortcutActivity" android:exported="true" android:taskAffinity="" android:excludeFromRecents="true" android:noHistory="true" android:theme="@android:style/Theme.Translucent.NoTitleBar"/>
        <activity android:name=".AddExpenseActivity" android:exported="true" android:theme="@style/AppTheme.Overlay" android:excludeFromRecents="true" android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|locale|layoutDirection"><!-- hunt 24 E9: rotating or a theme change keeps the open dialog and what was typed -->
            <intent-filter><action android:name="com.mybudget.app.action.ADD_EXPENSE"/><category android:name="android.intent.category.DEFAULT"/></intent-filter>
            <intent-filter><action android:name="com.mybudget.app.action.PAYMENT_UNDONE"/><category android:name="android.intent.category.DEFAULT"/></intent-filter>
        </activity>
        <!-- Planner's upcoming bills (see PlannerBills): a list to plan with, never money. -->
        <receiver android:name=".PlannerBills" android:exported="true">
            <intent-filter><action android:name="com.mybudget.app.action.UPCOMING_BILLS"/></intent-filter>
        </receiver>
        <!-- Automatic backup: a daily job that saves a backup file to the folder the user picked. -->
        <!-- Take a photo: the camera app writes into one cache file it's granted for that capture (see PhotoProvider). No CAMERA permission: the camera app takes the photo. -->
        <provider android:name=".PhotoProvider" android:authorities="${applicationId}.photos" android:exported="false" android:grantUriPermissions="true"/>
        <service android:name=".AutoBackup" android:permission="android.permission.BIND_JOB_SERVICE" android:exported="false"/>
        <!-- Reminders (as Planner's). The reminder receiver, the ringing service and BootReceiver are directBootAware, so a reminder
             rings after a reboot before the phone is first unlocked (from the snapshot in device-protected storage, see
             LockedAlarm). The button receiver (Enter it now, Skip) is not: it changes the budget, which can't be read until then,
             and its buttons ask for the unlock first. -->
        <receiver android:name=".ReminderReceiver" android:directBootAware="true" android:exported="false"/>
        <receiver android:name=".ReminderActionReceiver" android:exported="false"/>
        <!-- Plays the looping alarm sound; a media-playback foreground service keeps it alive while it rings. -->
        <service android:name=".AlarmService" android:directBootAware="true" android:exported="false" android:foregroundServiceType="mediaPlayback"/>
        <receiver android:name=".BootReceiver" android:directBootAware="true" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED"/>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.TIMEZONE_CHANGED"/>
                <action android:name="android.intent.action.TIME_SET"/>
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED"/>
            </intent-filter>
        </receiver>
        <!-- Its own task (no affinity): opening it from a notification must not bring MyBudget's screen forward under it. -->
        <activity android:name=".SnoozeActivity" android:exported="false" android:taskAffinity="" android:excludeFromRecents="true"
            android:theme="@style/AppTheme.Overlay"/>
    </application>
</manifest>
