<?xml version="1.0" encoding="utf-8"?>
<!-- The home-screen widget (BudgetWidget fills it in): To budget, "+" for a new transaction, and up to 5 pinned categories. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:background="@drawable/widget_background" android:paddingStart="14dp" android:paddingEnd="10dp" android:paddingTop="10dp" android:paddingBottom="8dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="28dp" android:layout_height="28dp" android:layout_marginEnd="10dp" android:src="@drawable/brand_mark" android:importantForAccessibility="no"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="To budget"
                android:textSize="11sp" android:textStyle="bold" android:textColor="@color/widget_muted" android:singleLine="true" android:ellipsize="end"/>
            <TextView android:id="@+id/widget_ready" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="MyBudget"
                android:textSize="20sp" android:textStyle="bold" android:textColor="@color/widget_ink" android:singleLine="true" android:ellipsize="end"/>
        </LinearLayout>
        <TextView android:id="@+id/widget_add" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:text="+"
            android:textSize="26sp" android:textColor="#FFFFFF" android:background="@drawable/widget_add" android:contentDescription="Add transaction"/>
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_row1" style="@style/WidgetRow"><TextView android:id="@+id/widget_name1" style="@style/WidgetName"/><TextView android:id="@+id/widget_amount1" style="@style/WidgetAmount"/></LinearLayout>
    <LinearLayout android:id="@+id/widget_row2" style="@style/WidgetRow"><TextView android:id="@+id/widget_name2" style="@style/WidgetName"/><TextView android:id="@+id/widget_amount2" style="@style/WidgetAmount"/></LinearLayout>
    <LinearLayout android:id="@+id/widget_row3" style="@style/WidgetRow"><TextView android:id="@+id/widget_name3" style="@style/WidgetName"/><TextView android:id="@+id/widget_amount3" style="@style/WidgetAmount"/></LinearLayout>
    <LinearLayout android:id="@+id/widget_row4" style="@style/WidgetRow"><TextView android:id="@+id/widget_name4" style="@style/WidgetName"/><TextView android:id="@+id/widget_amount4" style="@style/WidgetAmount"/></LinearLayout>
    <LinearLayout android:id="@+id/widget_row5" style="@style/WidgetRow"><TextView android:id="@+id/widget_name5" style="@style/WidgetName"/><TextView android:id="@+id/widget_amount5" style="@style/WidgetAmount"/></LinearLayout>
    <TextView android:id="@+id/widget_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:visibility="gone"
        android:text="Pin categories in Budget (Pin to Home) to see them here." android:textSize="12sp" android:textColor="@color/widget_muted"/>
</LinearLayout>
