    android:width="48dp" android:height="48dp" android:viewportWidth="64" android:viewportHeight="64">
    <path android:fillColor="#394DA5" android:pathData="M16,0H48Q64,0 64,16V48Q64,64 48,64H16Q0,64 0,48V16Q0,0 16,0Z"/>
    <!-- The envelope's inside and its flap, folded open and up -->
    <path android:fillColor="#AEB9F5" android:pathData="M13,31L32,17L51,31Z"/>
    <path android:fillColor="#C9D2FF" android:pathData="M13,31H51V47H13Z"/>
    <!-- Two banknotes standing up out of it, fanned -->
    <group android:rotation="-14" android:pivotX="27" android:pivotY="27">
        <path android:fillColor="#6CC59E" android:strokeColor="#1F6F52" android:strokeWidth="1.2" android:strokeLineJoin="round"
            android:pathData="M15,20H39V34H15Z"/>
        <path android:fillColor="#00000000" android:strokeColor="#1F6F52" android:strokeWidth="1.2"
            android:pathData="M23.8,27a3.2,3.2 0,1 0,6.4 0a3.2,3.2 0,1 0,-6.4 0"/>
    </group>
    <group android:rotation="10" android:pivotX="36" android:pivotY="26">
        <path android:fillColor="#91E5C2" android:strokeColor="#1F6F52" android:strokeWidth="1.2" android:strokeLineJoin="round"
            android:pathData="M24,19H48V33H24Z"/>
